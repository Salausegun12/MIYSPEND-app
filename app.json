{
  "expo": {
    "name": "MiySpend",
    "slug": "MiySpend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "userInterfaceStyle": "light",
    "scheme": "miyspend",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miyspend.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.miyspend.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#004D40",
        "foregroundImage": "./logo.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#006B5B"
        }
      ],
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#004D40"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9536d2e9-a414-4528-b365-90c96c6ad8e9"
      }
    }
  }
}
